prompt:
  system: |-
    You are a senior math education interface engineer. Output only one complete ASCII HTML file using the Desmos API. No Markdown fences or prose outside the source.
  text: |-
    Create an instructional Desmos API applet that explains how completing the square transforms y=x^2+6*x+5 into y=(x+3)^2-4. Show the original parabola, the transformed vertex form, the vertex point, x-intercepts, and a step list rendered as ordinary accessible HTML beside the calculator.

    Requirements: use setExpression ids for each graph element, labels for the vertex and roots, math bounds that frame all important points, a reset button using getState/setState, and a screenshot button. Use accessible text for the step list and avoid relying on color alone.
  provider_options:
    temperature: 0.2
    max_tokens: 8192
output:
  text_format: html
  artifact_kind: desmos-api-html
  formats:
  - format: html
  - format: png
  - format: svg
evaluation:
  checklist:
  - "YAML parses and required schema 0.4 fields are present."
  - "HTML is complete, ASCII-only, and uses Desmos API with stable ids and state reset."
  - "Math correctness covers completing the square, vertex form, roots, and graph equivalence."
  - "Notation validity covers escaped LaTeX, HTML step text, equation labels, and point labels."
  - "Renderability covers apiKey loading, visible container sizing, and screenshot export."
  - "Labels and units identify x, y, vertex, roots, original form, and vertex form."
  - "Domain edge cases cover duplicate expression ids, state reset, color-only distinctions, and offscreen labels."
  rubric:
  - name: Format validity
    weight: 30
    criteria:
    - "Output is one complete ASCII HTML file with no Markdown wrapper."
    - "The file uses valid Desmos API calls, accessible HTML, and stable initialization order."
    - "The source includes documented run, apiKey, reset, and export behavior."
  - name: Semantic completeness
    weight: 30
    criteria:
    - "Original form, vertex form, vertex, roots, explanatory steps, reset, and export are all implemented."
    - "The applet uses Desmos for the graph and HTML for readable instruction."
    - "The equivalence of the two forms is explicitly explained."
  - name: Visual/structural quality
    weight: 25
    criteria:
    - "Calculator and explanation fit cleanly without text overlap."
    - "Labels and redundant line styles remain readable for colorblind users."
    - "Initial viewport frames the complete instructional story."
  - name: Robustness
    weight: 15
    criteria:
    - "Reset restores the initial state and does not duplicate expressions."
    - "Screenshot and apiKey failure paths are documented."
    - "Layout remains responsive and accessible."
  pass_conditions:
  - "Rubric weights are exactly Format validity 30, Semantic completeness 30, Visual/structural quality 25, Robustness 15."
  - "Score is 80 or higher out of 100 with no critical failure in math correctness, notation validity, renderability, or accessibility."
  - "The artifact teaches completing the square with a working Desmos graph and readable explanation."
  - "Labels, units, domain edge cases, and state integration are represented."
