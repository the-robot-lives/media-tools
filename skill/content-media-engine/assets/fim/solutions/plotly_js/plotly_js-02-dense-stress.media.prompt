schema: "0.4"
id: plotly_js-02-dense-stress
type: visualization
quality: high
solution: plotly_js
category: js-charting
variant: dense-stress
references:
  - "references/fim/overview/data-visualization/plotly_js.md"
  - "references/fim/solution/plotly_js.md"
  - "assets/example-prompts/landing-page.media.prompt"
  - "assets/example-prompts/architecture-diagram.media.prompt"

prompt:
  system: |-
    You generate Plotly.js browser visualization artifacts. Output only a complete self-contained HTML document with inline CSS and JavaScript, using the Plotly.js CDN. Do not use markdown fences or explanations.
  text: |-
    Create the dense stress visualization for Plotly.js.
    
    Scenario:
    Create a dense visualization that intentionally stresses the solution with high-volume time series, many categories, or a large graph. Include built-in performance controls, filtering, and a clear explanation in the UI of the active sampling or rendering strategy.
    
    Implementation requirements:
    - Use this library source or equivalent npm import pattern: https://cdn.plot.ly/plotly-2.35.2.min.js.
    - Parser/API contract: Use Plotly.newPlot or Plotly.react with data traces, layout, and config; use restyle, relayout, toImage, downloadImage, and purge where appropriate.
    - Data encoding contract: Encode trace arrays with x, y, z, marker, line, hovertemplate, names, and axis references; choose trace types such as scattergl, heatmap, surface, or bar intentionally.
    - Responsive contract: Set config.responsive true, give the div a fluid size, and call Plotly.Plots.resize on container changes.
    - Accessibility contract: Add descriptive headings, annotations, hovertemplate text, high-contrast palette, keyboard-accessible controls, and a data summary table.
    - Edge data contract: Handle nulls, NaN, category ordering, WebGL unavailable, timezone values, empty traces, and SPA memory cleanup with Plotly.purge.
    - Performance contract: Use scattergl or WebGL traces for dense points, partial bundle notes, limited marker size, and Plotly.react for updates.
    - Integration contract: Expose renderFigure(fig), updateFigure(nextFig), exportImage(format), resizePlot(), and purgePlot() hooks.
    - Include deterministic inline sample data with realistic field names, units, and at least one edge case row.
    - Include concise visible titles, legends, units, source note, and no placeholder lorem ipsum text.
    - Output only the final artifact, with no commentary outside the artifact.
  provider_options:
    max_tokens: 8192
    temperature: 0.2

output:
  text_format: html
  artifact_kind: plotly-html-stress-visualization
  formats:
    - format: html

evaluation:
  checklist:
    - "Format validity: parseable schema 0.4 media prompt and generated artifact is exactly one html output with no markdown fences."
    - "Parser/API: Use Plotly.newPlot or Plotly.react with data traces, layout, and config; use restyle, relayout, toImage, downloadImage, and purge where appropriate."
    - "Data encoding: Encode trace arrays with x, y, z, marker, line, hovertemplate, names, and axis references; choose trace types such as scattergl, heatmap, surface, or bar intentionally."
    - "Responsive behavior: Set config.responsive true, give the div a fluid size, and call Plotly.Plots.resize on container changes."
    - "Accessibility: Add descriptive headings, annotations, hovertemplate text, high-contrast palette, keyboard-accessible controls, and a data summary table."
    - "Edge data: Handle nulls, NaN, category ordering, WebGL unavailable, timezone values, empty traces, and SPA memory cleanup with Plotly.purge."
    - "Performance/integration: Use scattergl or WebGL traces for dense points, partial bundle notes, limited marker size, and Plotly.react for updates. Expose renderFigure(fig), updateFigure(nextFig), exportImage(format), resizePlot(), and purgePlot() hooks."
  rubric:
    - name: "Format validity"
      weight: 30
      criteria: "The artifact is valid for the requested text format, contains no markdown fences, and uses the required solution parser or API without syntax errors."
    - name: "Semantic completeness"
      weight: 30
      criteria: "The visualization covers the requested scenario, data story, interactions, labels, and solution-specific capabilities."
    - name: "Visual/structural quality"
      weight: 25
      criteria: "The layout, hierarchy, color, typography, chart choice, and dashboard or diagram structure are clear and professional."
    - name: "Robustness"
      weight: 15
      criteria: "The artifact handles responsive layout, accessibility, edge data, update or teardown behavior, and performance constraints without runtime failures."
  pass_conditions:
    - "YAML parses successfully and all text is ASCII-only."
    - "Generated artifact runs without console errors when CDN dependencies are available."
    - "Parser/API, data encoding, responsive, accessibility, and edge data checklist items are all satisfied."
    - "Rubric score is at least 80 out of 100 and no rubric dimension scores zero."

tags:
  - "fim"
  - "js-charting"
  - "plotly_js"
  - "dense-stress"
  - "visualization"
  - "stress-test"
