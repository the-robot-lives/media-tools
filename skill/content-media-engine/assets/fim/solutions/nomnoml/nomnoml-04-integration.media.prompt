schema: "0.4"
id: fim-diagrams-dsl-xml-nomnoml-04-integration
type: diagram
quality: production
solution: nomnoml
category: diagrams-dsl-xml
variant: integration
prompt:
  system: You generate nomnoml source. Output only valid nomnoml text with directives, bracketed nodes,
    classifiers, and associations. Do not use code fences or explanatory prose.
  text: Create a nomnoml integration sketch for an API gateway, auth provider, partner API, webhook receiver,
    queue, worker, database, and observability sink. Include failure and retry relationships, note nodes
    for contracts, and directives for rightward layout.
  provider_options:
    max_tokens: 8192
    temperature: 0.2
    top_p: 0.9
output:
  text_format: nomnoml
  artifact_kind: uml_sketch_source
  formats:
  - format: nomnoml
  - format: svg
  - format: png
evaluation:
  checklist:
  - 'Output uses native nomnoml syntax: nomnoml directives, bracketed multi-compartment nodes, classifier
    prefixes, documented association operators, custom styles, and edge labels.'
  - 'Output captures the requested semantics: minimalist UML or flow sketches for classes, concepts, actors,
    databases, states, and simple flows.'
  - 'Output has solution-appropriate structure: clean hand-drawn style, limited clutter, meaningful compartments,
    and explicit relationship operators.'
  - 'Output is robust for the renderer/importer: brackets and pipes are escaped where needed, directives
    use valid values, and unsupported sequence-style constructs are avoided.'
  - Models boundaries, external systems, failure paths, references, ids, or import/export assumptions
    needed for integration work.
  - Output contains only the requested artifact source, with no Markdown fences, no explanatory prose,
    and no non-ASCII characters.
  rubric:
    Format validity:
      weight: 30
      criteria: 'Must parse as nomnoml and follow nomnoml-specific grammar: nomnoml directives, bracketed
        multi-compartment nodes, classifier prefixes, documented association operators, custom styles,
        and edge labels. Deduct heavily for malformed roots, unmatched blocks/tags, invalid ids, unresolved
        references, or mixing syntax from another diagram DSL.'
    Semantic completeness:
      weight: 30
      criteria: Must satisfy the full scenario for edge/integration use and include the domain entities,
        relationships, responsibilities, and edge/failure paths requested in the prompt. The diagram must
        use nomnoml for minimalist UML or flow sketches for classes, concepts, actors, databases, states,
        and simple flows.
    Visual/structural quality:
      weight: 25
      criteria: Must produce a readable rendered or importable artifact with clean hand-drawn style, limited
        clutter, meaningful compartments, and explicit relationship operators. Labels should be concise,
        grouping should reduce clutter, and styling/layout choices must match the strengths and limits
        of nomnoml.
    Robustness:
      weight: 15
      criteria: Must remain stable under normal rendering, import, export, or documentation use. Check
        brackets and pipes are escaped where needed, directives use valid values, and unsupported sequence-style
        constructs are avoided, avoid placeholders that block execution, and keep output ASCII-only and
        deterministic.
  pass_conditions:
  - Total rubric score is at least 85 out of 100.
  - Format validity score is at least 24 out of 30.
  - The generated artifact source has no code fences, no prose wrapper, and no non-ASCII characters.
  - The generated source can be parsed or imported by the normal nomnoml toolchain without unresolved
    references or missing required root elements.
tags:
- fim
- diagrams-dsl-xml
- nomnoml
- integration
- nomnoml
- uml-sketch
- concept-diagram

