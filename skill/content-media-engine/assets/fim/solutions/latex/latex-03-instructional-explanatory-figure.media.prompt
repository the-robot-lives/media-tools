prompt:
  system: |-
    You are a senior instructional LaTeX author. Output only one complete ASCII LaTeX source file. No Markdown fences or prose outside the source.
  text: |-
    Create an instructional LaTeX handout explaining matrix multiplication as row-by-column dot products. Include a labeled 2 by 3 times 3 by 2 example, color or pattern annotations that match terms, a TikZ figure showing row and column selection, and a step-by-step result matrix.

    Requirements: use amsmath and TikZ, include figure captions and labels, avoid vertical rules in any table, provide compile comments, and include a short accessibility note in comments describing the pattern labels for non-color viewing.
  provider_options:
    temperature: 0.2
    max_tokens: 8192
output:
  text_format: latex
  artifact_kind: latex-document
  formats:
  - format: tex
  render_expectation: "Compile the emitted .tex source with LaTeX to produce PDF render outputs; the LLM directly emits only TeX source."
evaluation:
  checklist:
  - "YAML parses and required schema 0.4 fields are present."
  - "LaTeX source is complete, ASCII-only, and combines amsmath with TikZ figure code."
  - "Math correctness covers matrix dimensions, dot products, and each result entry."
  - "Notation validity covers matrix environments, TikZ labels, captions, and cross references."
  - "Renderability covers package imports, TikZ compile path, and no external image dependencies."
  - "Labels and units identify rows, columns, dimensions, entries, products, and final matrix."
  - "Domain edge cases cover incompatible dimensions, color-only annotation, small page width, and label crowding."
  rubric:
  - name: Format validity
    weight: 30
    criteria:
    - "Output is one complete ASCII .tex file with no Markdown wrapper."
    - "The file compiles with documented LaTeX commands and valid TikZ syntax."
    - "All figures, captions, labels, and references are defined."
  - name: Semantic completeness
    weight: 30
    criteria:
    - "Example matrices, row-column figure, dot-product steps, final result, and accessibility note are all present."
    - "LaTeX and TikZ are used for the document and explanatory figure."
    - "The multiplication example is numerically correct."
  - name: Visual/structural quality
    weight: 25
    criteria:
    - "The figure clarifies row and column selection without clutter."
    - "Pattern and label choices remain understandable without color."
    - "Equations and matrices fit cleanly on the page."
  - name: Robustness
    weight: 15
    criteria:
    - "Explains incompatible-dimension checks."
    - "Uses deterministic numbers and self-contained graphics."
    - "Documents compiler and accessibility considerations."
  pass_conditions:
  - "Rubric weights are exactly Format validity 30, Semantic completeness 30, Visual/structural quality 25, Robustness 15."
  - "Score is 80 or higher out of 100 with no critical failure in math correctness, notation validity, renderability, or accessibility."
  - "The artifact compiles into an instructional matrix multiplication handout."
  - "Labels, dimensions, domain edge cases, and accessibility output are represented."
