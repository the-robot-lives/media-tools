schema: '0.4'
id: cytoscape_js-03-communication-storytelling
type: visualization
quality: high
solution: cytoscape_js
category: network-and-graph-visualization
variant: communication-storytelling-graph
prompt:
  context:
  - references/fim/overview/network-3d-graphics/cytoscape_js.md
  - references/fim/solution/cytoscape_js.md
  text: 'Create a Cytoscape.js communication graph that explains how an incident moved

    through a distributed system. Use compound nodes for zones, directed edge

    classes for request, retry, queue, alert, and remediation paths, and a stepper

    that highlights one causal phase at a time. Include tap or hover tooltips,

    selected-neighborhood dimming, and a final "root cause to recovery" path that

    uses Cytoscape path-finding to trace the story.

    '
  system: You generate artifacts for cytoscape_js. Output only the requested artifact content. No markdown fences, no explanations.
  provider_options:
    max_tokens: 6144
    temperature: 0.3
output:
  formats:
  - format: html
  - format: png
  renderer: cytoscape-js
  expected_artifact: Interactive story graph with phase highlights and path-finding.
  text_format: cytoscape_js
  artifact_kind: Interactive story graph with phase highlights and path-finding.
evaluation:
  checklist:
  - Uses Cytoscape classes and selectors for phase and edge-type styling.
  - Includes a causal story stepper and final highlighted path.
  - Uses graph algorithms or traversal to support the narrative.
  - Maintains readable labels and compound group structure.
  rubric:
  - name: Format validity
    weight: 30
    description: YAML parses and specifies a Cytoscape interactive output.
    criteria: YAML parses and specifies a Cytoscape interactive output.
  - name: Semantic completeness
    weight: 30
    description: Covers communication phases, edge semantics, interaction, and algorithmic path support.
    criteria: Covers communication phases, edge semantics, interaction, and algorithmic path support.
  - name: Visual/structural quality
    weight: 25
    description: Story states are clear and the graph does not become visually noisy.
    criteria: Story states are clear and the graph does not become visually noisy.
  - name: Robustness
    weight: 15
    description: Handles missing phase data, unconnected nodes, and repeated step transitions.
    criteria: Handles missing phase data, unconnected nodes, and repeated step transitions.
  pass_conditions:
  - The graph communicates a narrative arc, not just a topology inventory.
  - Cytoscape styling and algorithm features are explicitly used.
  - The final path is visible and inspectable.
tags:
- fim
- cytoscape-js
- storytelling
- communication-graph
- path-finding
- incident
