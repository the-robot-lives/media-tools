prompt:
  system: |-
    You are a senior instructional figure engineer. Output only one complete ASCII LaTeX source file using TikZ/PGF. No Markdown fences or prose outside the source.
  text: |-
    Create an instructional TikZ figure explaining the unit-circle definitions of sin(theta) and cos(theta). Draw the unit circle, coordinate axes, point P at angle theta, radius OP, projections to axes, right triangle, angle arc, and labels for cos(theta), sin(theta), and theta.

    Requirements: use TikZ coordinate math or pgfmath, arrows.meta, calc if useful, reusable styles, caption and label, compile comments, units in radians, and non-color encodings for projections and radius. Avoid relying on an external image.
  provider_options:
    temperature: 0.2
    max_tokens: 8192
output:
  text_format: latex
  artifact_kind: tikz-pgf-latex
  formats:
  - format: tex
  - format: pdf
  - format: svg
evaluation:
  checklist:
  - "YAML parses and required schema 0.4 fields are present."
  - "LaTeX source is complete, ASCII-only, and uses TikZ coordinate construction."
  - "Math correctness covers unit radius, coordinate projections, angle definition, and sine/cosine labels."
  - "Notation validity covers TeX labels, theta notation, coordinate syntax, captions, and compile comments."
  - "Renderability covers required libraries, compiler path, and nonblank vector output."
  - "Labels and units identify x, y, P, theta in radians, radius, cosine projection, and sine projection."
  - "Domain edge cases cover theta near 0 or pi/2, label overlap, aspect ratio, and color-only encodings."
  rubric:
  - name: Format validity
    weight: 30
    criteria:
    - "Output is one complete ASCII LaTeX file with no Markdown wrapper."
    - "The file compiles with valid TikZ syntax and documented commands."
    - "All styles, coordinates, labels, captions, and references are defined."
  - name: Semantic completeness
    weight: 30
    criteria:
    - "Circle, axes, point, radius, projections, triangle, angle arc, labels, and caption are all present."
    - "TikZ/PGF constructs the figure precisely."
    - "The sine and cosine definitions are correctly represented."
  - name: Visual/structural quality
    weight: 25
    criteria:
    - "The figure is clean, balanced, and readable at document scale."
    - "Line styles and labels clarify the projections without relying only on color."
    - "No labels are clipped or ambiguous."
  - name: Robustness
    weight: 15
    criteria:
    - "Handles common angle positions and label placement."
    - "Uses deterministic coordinates and no external dependencies."
    - "Documents compile and export constraints."
  pass_conditions:
  - "Rubric weights are exactly Format validity 30, Semantic completeness 30, Visual/structural quality 25, Robustness 15."
  - "Score is 80 or higher out of 100 with no critical failure in math correctness, notation validity, renderability, or accessibility."
  - "The artifact compiles into an instructional unit-circle TikZ figure."
  - "Labels, units, domain edge cases, and accessibility considerations are represented."
