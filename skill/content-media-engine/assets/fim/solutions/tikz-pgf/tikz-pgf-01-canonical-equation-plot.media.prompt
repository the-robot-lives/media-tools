prompt:
  system: |-
    You are a senior TikZ/PGF scientific figure engineer. Output only one complete ASCII LaTeX source file containing a TikZ/PGF figure. No Markdown fences or prose outside the source.
  text: |-
    Create a canonical TikZ/PGF pgfplots figure for y=x^2-5*x+6. Mark and label both roots, the vertex, and the axis of symmetry. Use a standalone or minimal article document with pgfplots, axes labels, legend, grid, caption, and compile comments.

    Requirements: use pgfplots axis with deterministic domain and samples, valid TeX math labels, colorblind-safe styles plus dashed/solid redundancy, units for x and y, and no external data files. Include comments for pdflatex or latexmk compilation and SVG conversion.
  provider_options:
    temperature: 0.2
    max_tokens: 8192
output:
  text_format: latex
  artifact_kind: tikz-pgf-latex
  formats:
  - format: tex
  - format: pdf
  - format: svg
evaluation:
  checklist:
  - "YAML parses and required schema 0.4 fields are present."
  - "LaTeX source is complete, ASCII-only, and uses TikZ/PGF or pgfplots as the primary figure system."
  - "Math correctness covers polynomial curve, roots, vertex, axis of symmetry, and sample domain."
  - "Notation validity covers pgfplots syntax, TeX labels, legend entries, units, and compile comments."
  - "Renderability covers package imports, compiler path, no external data dependency, and nonblank figure output."
  - "Labels and units identify x, y, roots, vertex, axis of symmetry, and plotted function."
  - "Domain edge cases cover repeated roots, offscreen extrema, label overlap, TeX trig syntax where relevant, and export conversion."
  rubric:
  - name: Format validity
    weight: 30
    criteria:
    - "Output is one complete ASCII LaTeX file with no Markdown wrapper."
    - "The file compiles with documented commands and valid TikZ/PGF syntax."
    - "The source uses stable labels, captions, and output expectations."
  - name: Semantic completeness
    weight: 30
    criteria:
    - "Curve, roots, vertex, symmetry axis, labels, grid, legend, caption, and compile notes are all present."
    - "TikZ/PGF is the primary vector rendering surface."
    - "The mathematical annotations are correct."
  - name: Visual/structural quality
    weight: 25
    criteria:
    - "The figure is publication-ready with readable labels and no clipped annotations."
    - "Styles remain distinguishable in grayscale or colorblind contexts."
    - "PDF and SVG outputs preserve vector clarity."
  - name: Robustness
    weight: 15
    criteria:
    - "Handles label placement, bounded domain, and no external file requirements."
    - "Documents compiler and conversion assumptions."
    - "Notes key polynomial edge cases."
  pass_conditions:
  - "Rubric weights are exactly Format validity 30, Semantic completeness 30, Visual/structural quality 25, Robustness 15."
  - "Score is 80 or higher out of 100 with no critical failure in math correctness, notation validity, or renderability."
  - "The artifact compiles into a labeled TikZ/PGF polynomial plot."
  - "Domain edge cases and export constraints are represented."
