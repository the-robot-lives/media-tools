schema: "0.4"
id: anime_js-04-edge-integration-reduced-motion-performance
type: interactive
quality: high
solution: anime_js
category: animation-and-motion
variant: edge-integration-reduced-motion-performance
references:
  - "references/fim/overview/canvas-svg-creative-animation/anime_js.md"
  - "references/fim/solution/anime_js.md"
prompt:
  system: |-
    Generate production-quality Anime.js integration edge-case assets for FIM evaluation. Output only a complete self-contained HTML document with inline CSS and JavaScript.
  text: |-
    Create an Anime.js integration and robustness harness focused on reduced motion, missing targets, teardown, and performance.

    Scenario:
    Build a self-contained widget that can be mounted, destroyed, and remounted. It should animate an SVG progress path, a DOM queue of cards, and a small numeric status object. Include toggles for reduced motion, target fault injection, slow-device mode, and timeline rebuild.

    Implementation requirements:
    - Use Anime.js 3.2.1 from a CDN or equivalent import and expose initAnimation(root), destroyAnimation(), rebuildAnimation(), and setReducedMotion(enabled).
    - Validate DOM and SVG targets by root-scoped selectors before constructing tweens; report missing target names without crashing.
    - Specify millisecond durations, easing, stagger intervals, loop or non-loop sections, and pause/resume behavior.
    - Use transform, opacity, and SVG attributes rather than layout animation; include a target-count and active-animation diagnostic.
    - Honor prefers-reduced-motion and a manual reduced-motion toggle by rendering a static final state and disabling loops.
    - Include resize handling, no-overlap responsive constraints, and a cleanup path that pauses/removes timelines before remounting.
    - Include a performance guard for low-power mode that reduces target count, duration, or loop frequency.
    - Output only the final artifact, with no markdown fences or explanatory prose outside the artifact.
  provider_options:
    max_tokens: 8192
    temperature: 0.2
output:
  text_format: html
  artifact_kind: animejs-html-edge-integration-reduced-motion-performance
  formats:
    - format: html
  dimensions:
    width: 1440
    height: 900
  render_expectation: "Interactive robustness harness that survives mount, destroy, remount, reduced-motion, and target-fault states."
evaluation:
  checklist:
    - "Format validity: YAML parses under schema 0.4 and generated output is exactly one HTML artifact with no markdown fences."
    - "Anime.js API: Uses root-scoped valid DOM/SVG targets, timeline creation, object tweening, and explicit lifecycle functions."
    - "Motion timing: Specifies durations in milliseconds, easing, stagger, loop boundaries, pause/resume, and rebuild behavior."
    - "Visual quality: Diagnostics, controls, cards, and SVG animation remain readable with no overlap after resize or remount."
    - "Reduced motion: Supports prefers-reduced-motion and manual toggle with loops disabled and a static final state."
    - "Performance: Provides low-power mode, bounded target count, no unbounded per-frame work, and complete cleanup."
  rubric:
    - name: "Format validity"
      weight: 30
      criteria: "YAML and generated HTML are syntactically valid, required fields are present, id and file name match, and the artifact uses Anime.js rather than a substitute animation library."
    - name: "Semantic completeness"
      weight: 30
      criteria: "The artifact covers lifecycle integration, target validation, timing, easing, looping, reduced motion, resize, diagnostics, and performance guards."
    - name: "Motion/visual quality"
      weight: 25
      criteria: "Motion remains smooth, legible, correctly targeted, and non-overlapping across normal, reduced-motion, and fault-injection states."
    - name: "Robustness"
      weight: 15
      criteria: "Handles missing targets, destroy/remount, reduced motion, resize, and low-power operation without blank screens or runtime errors."
  pass_conditions:
    - "Rubric weights are exactly 30, 30, 25, and 15 for a total of 100."
    - "YAML parses successfully and all prompt text is ASCII-only."
    - "Generated artifact runs with no console errors when Anime.js is available."
    - "Score is at least 80 out of 100 with no zero score in any rubric dimension."
tags:
  - "fim"
  - "animation-and-motion"
  - "anime_js"
  - "edge-integration-reduced-motion-performance"
  - "reduced-motion"
  - "lifecycle"
