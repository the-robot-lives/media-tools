schema: "0.4"
id: observable-plot-02-dense-stress
type: visualization
quality: high
solution: observable-plot
category: js-charting
variant: dense-stress
references:
  - "references/fim/overview/data-visualization/observable-plot.md"
  - "references/fim/solution/observable-plot.md"
  - "assets/example-prompts/landing-page.media.prompt"
  - "assets/example-prompts/architecture-diagram.media.prompt"

prompt:
  system: |-
    You generate Observable Plot browser visualization artifacts. Output only a complete self-contained HTML document with inline CSS and module JavaScript, using the Observable Plot CDN. Do not use markdown fences or explanations.
  text: |-
    Create the dense stress visualization for Observable Plot.
    
    Scenario:
    Create a dense visualization that intentionally stresses the solution with high-volume time series, many categories, or a large graph. Include built-in performance controls, filtering, and a clear explanation in the UI of the active sampling or rendering strategy.
    
    Implementation requirements:
    - Use this library source or equivalent npm import pattern: https://cdn.jsdelivr.net/npm/@observablehq/plot@0.6/+esm.
    - Parser/API contract: Use Plot.plot with composable marks such as Plot.dot, Plot.line, Plot.barY, Plot.rectY, Plot.ruleY, and Plot transforms as appropriate.
    - Data encoding contract: Encode tidy arrays of typed objects, map fields or accessors to channels, use Plot.group, bin, stack, window, or filter transforms where useful.
    - Responsive contract: Compute width from the container, recreate the returned SVG on resize, and keep margins large enough for axes and labels.
    - Accessibility contract: Add captions, SVG title or aria-label, readable color schemes, non-color encodings, and a table fallback.
    - Edge data contract: Handle wrong field names, non-numeric strings, missing dates, NaN values, clipped labels, empty filters, and more than 100k SVG points by aggregating.
    - Performance contract: Use bin, group, hexbin, sample, or pre-aggregation; avoid rendering raw huge point clouds in SVG.
    - Integration contract: Expose renderPlot(rows), replacePlot(rows), exportSvg(), resizePlot(), and clearPlot() hooks.
    - Include deterministic inline sample data with realistic field names, units, and at least one edge case row.
    - Include concise visible titles, legends, units, source note, and no placeholder lorem ipsum text.
    - Output only the final artifact, with no commentary outside the artifact.
  provider_options:
    max_tokens: 8192
    temperature: 0.2

output:
  text_format: html
  artifact_kind: observable-plot-html-stress-visualization
  formats:
    - format: html

evaluation:
  checklist:
    - "Format validity: parseable schema 0.4 media prompt and generated artifact is exactly one html output with no markdown fences."
    - "Parser/API: Use Plot.plot with composable marks such as Plot.dot, Plot.line, Plot.barY, Plot.rectY, Plot.ruleY, and Plot transforms as appropriate."
    - "Data encoding: Encode tidy arrays of typed objects, map fields or accessors to channels, use Plot.group, bin, stack, window, or filter transforms where useful."
    - "Responsive behavior: Compute width from the container, recreate the returned SVG on resize, and keep margins large enough for axes and labels."
    - "Accessibility: Add captions, SVG title or aria-label, readable color schemes, non-color encodings, and a table fallback."
    - "Edge data: Handle wrong field names, non-numeric strings, missing dates, NaN values, clipped labels, empty filters, and more than 100k SVG points by aggregating."
    - "Performance/integration: Use bin, group, hexbin, sample, or pre-aggregation; avoid rendering raw huge point clouds in SVG. Expose renderPlot(rows), replacePlot(rows), exportSvg(), resizePlot(), and clearPlot() hooks."
  rubric:
    - name: "Format validity"
      weight: 30
      criteria: "The artifact is valid for the requested text format, contains no markdown fences, and uses the required solution parser or API without syntax errors."
    - name: "Semantic completeness"
      weight: 30
      criteria: "The visualization covers the requested scenario, data story, interactions, labels, and solution-specific capabilities."
    - name: "Visual/structural quality"
      weight: 25
      criteria: "The layout, hierarchy, color, typography, chart choice, and dashboard or diagram structure are clear and professional."
    - name: "Robustness"
      weight: 15
      criteria: "The artifact handles responsive layout, accessibility, edge data, update or teardown behavior, and performance constraints without runtime failures."
  pass_conditions:
    - "YAML parses successfully and all text is ASCII-only."
    - "Generated artifact runs without console errors when CDN dependencies are available."
    - "Parser/API, data encoding, responsive, accessibility, and edge data checklist items are all satisfied."
    - "Rubric score is at least 80 out of 100 and no rubric dimension scores zero."

tags:
  - "fim"
  - "js-charting"
  - "observable-plot"
  - "dense-stress"
  - "visualization"
  - "stress-test"
