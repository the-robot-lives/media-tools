schema: "0.4"
id: ffmpeg-wasm-01-canonical-transform-pipeline
type: image/visualization/data
quality: high
solution: ffmpeg-wasm
category: image-and-video-processing
variant: canonical-transform-pipeline
references:
  - "references/fim/overview/electronics-media-docfile/ffmpeg-wasm.md"
  - "references/fim/solution/ffmpeg-wasm.md"
prompt:
  system: |-
    You generate FFmpeg.wasm media-processing artifacts. Output only one complete ASCII JavaScript module. Do not use markdown fences or explanatory prose.
  text: |-
    Create a canonical browser FFmpeg.wasm transform pipeline for a privacy-first video editor.

    Requirements:
    - Use @ffmpeg/ffmpeg 0.12 style APIs: new FFmpeg(), load(), writeFile(), exec(), readFile(), deleteFile(), and terminate().
    - Load the core with explicit coreURL and wasmURL through toBlobURL, and document the single-thread fallback path.
    - Accept a File or Blob input and produce a trimmed, scaled, color-normalized MP4 plus one JPEG thumbnail.
    - Use deterministic CLI argument arrays with -ss, -t, -vf scale=1280:720:force_original_aspect_ratio=decrease,pad=1280:720:-1:-1:color=black,fps=30, -c:v libx264, -crf 22, -preset veryfast, -pix_fmt yuv420p, and copied or AAC audio.
    - Emit an additional thumbnail at 00:00:02 with -frames:v 1 and -q:v 2.
    - Include dimensions 1280x720 for video and 1280x720 for the thumbnail, srgb display assumptions, yuv420p output, no alpha for MP4/JPEG, and explicit input/output file formats.
    - Include memory and performance controls: maximum input size, progress events, cancellation through AbortSignal, MEMFS cleanup, and worker termination.
    - Write deterministic metadata JSON with source name hash, input bytes, requested trim range, output dimensions, formats, codec settings, and stable output filenames.
    - Output only the final JavaScript artifact.
  provider_options:
    max_tokens: 8192
    temperature: 0.2
output:
  text_format: javascript
  artifact_kind: ffmpeg-wasm-canonical-transform-module
  dimensions:
    width: 1280
    height: 720
  color_profile: srgb-display-yuv420p-output
  alpha: none
  formats:
    - format: js
    - format: mp4
    - format: jpg
evaluation:
  checklist:
    - "Format validity: YAML parses as schema 0.4, generated output is one JavaScript module, and FFmpeg.wasm 0.12 APIs are used."
    - "Semantic completeness: load, writeFile, exec, readFile, cleanup, progress, cancellation, MP4 output, and thumbnail output are all present."
    - "Dimensions: video and thumbnail output are fixed to 1280x720 without accidental aspect distortion."
    - "Color profile and alpha: output uses yuv420p for playback compatibility, assumes srgb display, and does not claim alpha for MP4 or JPEG."
    - "File formats: input media is accepted from File or Blob and outputs include MP4, JPEG, and metadata JSON with stable filenames."
    - "Memory and performance: input size caps, progress callbacks, AbortSignal cancellation, MEMFS deletion, and terminate() are implemented."
    - "Metadata: metadata JSON records source hash, bytes, trim range, dimensions, codec settings, and output names without leaking raw media."
    - "Deterministic output: command argument order, filenames, metadata keys, and thumbnail timestamp are stable across reruns."
  rubric:
    - name: "Format validity"
      weight: 30
      criteria: "The prompt YAML and generated JavaScript are parseable, ASCII-only, and use FFmpeg.wasm as the primary engine."
    - name: "Semantic completeness"
      weight: 30
      criteria: "The artifact covers the complete load, transform, thumbnail, readback, cleanup, progress, and cancellation lifecycle."
    - name: "Output quality"
      weight: 25
      criteria: "The generated media settings produce legible 1280x720 video and thumbnail outputs with compatible codec, pixel format, and stable filenames."
    - name: "Robustness"
      weight: 15
      criteria: "The artifact handles browser memory limits, cancellation, missing core assets, failed conversions, stale MEMFS files, and deterministic metadata."
  pass_conditions:
    - "YAML parses successfully and all file text is ASCII-only."
    - "Rubric weights are exactly Format validity 30, Semantic completeness 30, Output quality 25, and Robustness 15."
    - "Generated JavaScript contains no markdown fences and uses FFmpeg.wasm rather than native ffmpeg."
    - "All dimensions, color profile/alpha, file format, memory/performance, metadata, and deterministic output checks are represented."
    - "Rubric score is at least 80 out of 100 and no required checklist item is absent."
tags:
  - fim
  - image-and-video-processing
  - ffmpeg-wasm
  - canonical-transform-pipeline
  - browser-video
  - mp4
  - thumbnail
