schema: '0.4'
id: music21j-01-lead-sheet-simple-score
type: music21j
quality: high
solution: music21j
category: music-notation
variant: lead-sheet-simple-score
references:
- references/fim/overview/music-audio-ml/music21j.md
- references/fim/solution/music21j.md
prompt:
  system: Output a JavaScript ES module exporting buildScore(music21), returning a Score, Part or Stream
    constructed with the supplied music21j namespace. Include only musical score construction. No imports,
    HTML, DOM operations, playback controls or Markdown fences.
  text: Generate a happy upbeat classical song in C major, 16 bars in 4/4, with a memorable melody, simple
    piano accompaniment, a contrasting middle phrase and a clear final cadence. Give it a title and a
    lively tempo. Keep every measure rhythmically complete.
  provider_options:
    max_tokens: 8192
    temperature: 0.2
output:
  text_format: music21j
  formats:
  - format: mjs
tags:
- fim
- music-notation
- music21j
- lead-sheet
- native-module
eval:
  pass_threshold: 0.8
  criteria:
    musical_coherence:
      weight: 3
      description: Coherent 16-bar C-major classical melody, accompaniment and final cadence.
    score_structure:
      weight: 3
      description: Every measure totals 4 quarter lengths and declares meter, key and part structure.
    artifact_contract:
      weight: 2
      description: Valid ES module exports buildScore(music21) returning a score without HTML, imports,
        DOM or playback UI.
