schema: "0.4"
id: apache-echarts-04-edge-integration
type: visualization
quality: high
solution: apache-echarts
category: js-charting
variant: edge-integration
references:
  - "references/fim/overview/data-visualization/apache-echarts.md"
  - "references/fim/solution/apache-echarts.md"
  - "assets/example-prompts/landing-page.media.prompt"
  - "assets/example-prompts/architecture-diagram.media.prompt"

prompt:
  system: |-
    You generate Apache ECharts browser visualization artifacts. Output only a complete self-contained HTML document with inline CSS and JavaScript, using the Apache ECharts CDN. Do not use markdown fences or explanations.
  text: |-
    Create the edge integration output for Apache ECharts.
    
    Scenario:
    Create an embeddable analytics widget that demonstrates integration behavior. It must support resizing, data refresh, export where the library supports it, cleanup, and visible handling for empty, partial, malformed, and extreme data.
    
    Implementation requirements:
    - Use this library source or equivalent npm import pattern: https://cdn.jsdelivr.net/npm/echarts@5.4.3/dist/echarts.min.js.
    - Parser/API contract: Use echarts.init on a sized DOM container and chart.setOption with a valid option object; choose Canvas or SVG renderer intentionally and include chart.resize handling.
    - Data encoding contract: Encode values through ECharts dataset/source or series.data arrays with explicit xAxis, yAxis, visualMap, legend, tooltip, and dataZoom where relevant.
    - Responsive contract: Use a fluid container, ResizeObserver or window resize, and ECharts media options or manual breakpoints for small screens.
    - Accessibility contract: Enable or emulate ECharts aria support, include an off-screen data summary, descriptive title, and high-contrast palette.
    - Edge data contract: Handle nulls, zeros, outliers, duplicate categories, empty series, and large input with sampling, progressive rendering, or large mode as appropriate.
    - Performance contract: Use large mode, sampling, progressive rendering, disabled animation, and dataZoom for high-volume series.
    - Integration contract: Expose updateChart(nextRows), exportImage(), resizeChart(), and disposeChart() hooks around the ECharts instance.
    - Include deterministic inline sample data with realistic field names, units, and at least one edge case row.
    - Include concise visible titles, legends, units, source note, and no placeholder lorem ipsum text.
    - Output only the final artifact, with no commentary outside the artifact.
  provider_options:
    max_tokens: 8192
    temperature: 0.2

output:
  text_format: html
  artifact_kind: echarts-html-integration-widget
  formats:
    - format: html

evaluation:
  checklist:
    - "Format validity: parseable schema 0.4 media prompt and generated artifact is exactly one html output with no markdown fences."
    - "Parser/API: Use echarts.init on a sized DOM container and chart.setOption with a valid option object; choose Canvas or SVG renderer intentionally and include chart.resize handling."
    - "Data encoding: Encode values through ECharts dataset/source or series.data arrays with explicit xAxis, yAxis, visualMap, legend, tooltip, and dataZoom where relevant."
    - "Responsive behavior: Use a fluid container, ResizeObserver or window resize, and ECharts media options or manual breakpoints for small screens."
    - "Accessibility: Enable or emulate ECharts aria support, include an off-screen data summary, descriptive title, and high-contrast palette."
    - "Edge data: Handle nulls, zeros, outliers, duplicate categories, empty series, and large input with sampling, progressive rendering, or large mode as appropriate."
    - "Performance/integration: Use large mode, sampling, progressive rendering, disabled animation, and dataZoom for high-volume series. Expose updateChart(nextRows), exportImage(), resizeChart(), and disposeChart() hooks around the ECharts instance."
  rubric:
    - name: "Format validity"
      weight: 30
      criteria: "The artifact is valid for the requested text format, contains no markdown fences, and uses the required solution parser or API without syntax errors."
    - name: "Semantic completeness"
      weight: 30
      criteria: "The visualization covers the requested scenario, data story, interactions, labels, and solution-specific capabilities."
    - name: "Visual/structural quality"
      weight: 25
      criteria: "The layout, hierarchy, color, typography, chart choice, and dashboard or diagram structure are clear and professional."
    - name: "Robustness"
      weight: 15
      criteria: "The artifact handles responsive layout, accessibility, edge data, update or teardown behavior, and performance constraints without runtime failures."
  pass_conditions:
    - "YAML parses successfully and all text is ASCII-only."
    - "Generated artifact runs without console errors when CDN dependencies are available."
    - "Parser/API, data encoding, responsive, accessibility, and edge data checklist items are all satisfied."
    - "Rubric score is at least 80 out of 100 and no rubric dimension scores zero."

tags:
  - "fim"
  - "js-charting"
  - "apache-echarts"
  - "edge-integration"
  - "visualization"
  - "integration"
