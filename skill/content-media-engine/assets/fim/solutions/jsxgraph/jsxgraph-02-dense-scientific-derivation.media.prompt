prompt:
  system: |-
    You are a senior interactive calculus engineer. Output only one complete ASCII HTML file using JSXGraph. No Markdown fences or prose outside the source.
  text: |-
    Create a dense JSXGraph calculus board showing f(x)=sin(x)*exp(-k*x/6), its numeric derivative, a tangent line at x=t, and the signed area integral over [u,v]. Use sliders for k, t, u, and v; JXG.Math.Numerics.D for derivative display; board.create integral or polygon shading where appropriate; and live text readouts for f(t), f'(t), and area.

    Requirements: batch element creation with suspendUpdate and unsuspendUpdate where useful, keep expression functions stable, label axes and units, avoid recreating dense elements on every update, and include an explanatory derivation panel in accessible HTML.
  provider_options:
    temperature: 0.2
    max_tokens: 8192
output:
  text_format: html
  artifact_kind: jsxgraph-html
  formats:
  - format: html
  - format: png
  - format: svg
evaluation:
  checklist:
  - "YAML parses and required schema 0.4 fields are present."
  - "HTML is complete, ASCII-only, and uses JSXGraph numeric derivative, sliders, text, and integral-style elements."
  - "Math correctness covers derivative approximation, tangent point, signed interval area, and damping parameter."
  - "Notation validity covers labels, slider names, derivative notation, integral interval notation, and readouts."
  - "Renderability covers nonzero board dimensions, dependency loading, and nonblank dense visualization."
  - "Labels and units identify x, response, damping, tangent point, derivative, and integration interval."
  - "Domain edge cases cover u>v, extreme k, dense sampling, viewport clipping, and update performance."
  rubric:
  - name: Format validity
    weight: 30
    criteria:
    - "Output is one complete ASCII HTML file with no Markdown wrapper."
    - "The file uses valid JSXGraph APIs and deterministic board initialization."
    - "The source documents dependencies, local run, and capture expectations."
  - name: Semantic completeness
    weight: 30
    criteria:
    - "Function, derivative, tangent, area, sliders, live readouts, and derivation panel are all present."
    - "The implementation uses JSXGraph dependent objects and numeric helpers idiomatically."
    - "The derivation panel matches the plotted math."
  - name: Visual/structural quality
    weight: 25
    criteria:
    - "Dense layers are distinguishable through hierarchy, line styles, labels, and spacing."
    - "The graph remains readable across slider changes."
    - "HTML readouts support the board without crowding it."
  - name: Robustness
    weight: 15
    criteria:
    - "Handles reversed intervals, extreme damping, and redraw performance safely."
    - "Avoids unbounded object creation during updates."
    - "Documents browser, resize, and export limitations."
  pass_conditions:
  - "Rubric weights are exactly Format validity 30, Semantic completeness 30, Visual/structural quality 25, Robustness 15."
