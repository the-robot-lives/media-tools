prompt:
  system: |-
    You are a senior Python symbolic mathematics engineer. Output only one complete ASCII Python file using SymPy. No Markdown fences or prose outside the source.
  text: |-
    Create a canonical SymPy script that solves x^2-5*x+6=0 exactly, verifies roots by substitution, prints LaTeX for the equation and solution set, and saves a styled plot of the polynomial with roots marked. Use symbols with assumptions, Eq, solve or solveset, simplify, latex, and sympy.plotting with show=False.

    Requirements: include run comments for python, deterministic output filenames, exact integers or Rational values, labeled axes with units, colorblind-safe line styles, and comments explaining when a=0 or discriminant<0 changes the domain story.
  provider_options:
    temperature: 0.2
    max_tokens: 8192
output:
  text_format: python
  artifact_kind: sympy-script
  formats:
  - format: py
  - format: tex
  - format: svg
  - format: png
evaluation:
  checklist:
  - "YAML parses and required schema 0.4 fields are present."
  - "Python source is complete, ASCII-only, and imports SymPy as the primary math engine."
  - "Math correctness covers exact solve, substitution verification, LaTeX output, and plotted polynomial."
  - "Notation validity covers Eq usage, symbol assumptions, LaTeX strings, labels, units, and plot legend."
  - "Renderability covers Python execution, required imports, show=False plotting, and saved outputs."
  - "Labels and units identify x, y, roots, equation, exact values, and verification status."
  - "Domain edge cases cover a=0, repeated roots, complex roots, float contamination, and missing matplotlib."
  rubric:
  - name: Format validity
    weight: 30
    criteria:
    - "Output is one complete ASCII Python file with no Markdown wrapper."
    - "The script runs with documented dependencies and writes stable outputs."
    - "The source uses valid SymPy APIs and plotting syntax."
  - name: Semantic completeness
    weight: 30
    criteria:
    - "Exact solve, verification, LaTeX emission, plot, labels, and exports are all present."
    - "SymPy is the primary symbolic engine and is not replaced by numeric-only code."
    - "The computed roots and plot agree."
  - name: Visual/structural quality
    weight: 25
    criteria:
    - "The plot has readable labels, root markers, legend, and stable bounds."
    - "Text outputs are organized and auditable."
    - "Line styles and colors remain distinguishable."
  - name: Robustness
    weight: 15
    criteria:
    - "Handles key quadratic edge cases in code or comments."
    - "Uses exact values and avoids Python float contamination."
    - "Documents matplotlib dependency and output limitations."
  pass_conditions:
  - "Rubric weights are exactly Format validity 30, Semantic completeness 30, Visual/structural quality 25, Robustness 15."
  - "Score is 80 or higher out of 100 with no critical failure in math correctness, notation validity, or renderability."
  - "The artifact runs as a SymPy script and writes labeled symbolic and plot outputs."
