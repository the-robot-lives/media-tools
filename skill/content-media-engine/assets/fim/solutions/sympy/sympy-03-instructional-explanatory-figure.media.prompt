prompt:
  system: |-
    You are a senior symbolic math education engineer. Output only one complete ASCII Python file using SymPy. No Markdown fences or prose outside the source.
  text: |-
    Create an instructional SymPy script that explains Taylor approximation for exp(x). Compute exact polynomials through orders 1, 2, 3, and 5, print LaTeX forms, verify coefficients from derivatives at zero, plot the exact function and approximations, and save SVG plus PNG outputs.

    Requirements: use symbols, series or diff, removeO, factorial checks, exact Rational values where needed, labeled axes, legend labels, a text summary for each order, and comments explaining why the approximation worsens away from x=0.
  provider_options:
    temperature: 0.2
    max_tokens: 8192
output:
  text_format: python
  artifact_kind: sympy-script
  formats:
  - format: py
  - format: tex
  - format: svg
  - format: png
evaluation:
  checklist:
  - "YAML parses and required schema 0.4 fields are present."
  - "Python source is complete, ASCII-only, and uses SymPy series or derivative-based coefficients."
  - "Math correctness covers Taylor coefficients, polynomial orders, derivative verification, and approximation behavior."
  - "Notation validity covers LaTeX output, O-term removal, legend labels, axes, and summary text."
  - "Renderability covers Python execution, plot export, and no GUI requirement."
  - "Labels and units identify x, exp(x), each polynomial order, expansion point, and approximation error."
  - "Domain edge cases cover large x, order selection, exact-to-numeric conversion, missing matplotlib, and crowded legends."
  rubric:
  - name: Format validity
    weight: 30
    criteria:
    - "Output is one complete ASCII Python file with no Markdown wrapper."
    - "The script uses valid SymPy and plotting APIs and writes stable outputs."
    - "The source documents run commands and dependencies."
  - name: Semantic completeness
    weight: 30
    criteria:
    - "Polynomials, coefficient verification, LaTeX forms, plot overlays, summaries, and exports are all present."
    - "SymPy performs the symbolic approximation work."
    - "The instructional explanation is mathematically correct."
  - name: Visual/structural quality
    weight: 25
    criteria:
    - "The plot clearly distinguishes exact function and approximations."
    - "Labels, legend, and text summaries are readable."
    - "Code structure supports teaching and auditability."
  - name: Robustness
    weight: 15
    criteria:
    - "Discusses approximation error away from expansion point."
    - "Uses exact coefficients before numeric plotting."
    - "Documents plotting dependency and export constraints."
  pass_conditions:
  - "Rubric weights are exactly Format validity 30, Semantic completeness 30, Visual/structural quality 25, Robustness 15."
  - "Score is 80 or higher out of 100 with no critical failure in math correctness, notation validity, renderability, or accessibility."
  - "The artifact teaches Taylor approximation through SymPy symbolic output and labeled plots."
