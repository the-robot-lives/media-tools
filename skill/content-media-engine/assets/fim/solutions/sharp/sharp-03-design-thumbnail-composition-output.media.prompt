schema: "0.4"
id: sharp-03-design-thumbnail-composition-output
type: image/visualization/data
quality: high
solution: sharp
category: image-and-video-processing
variant: design-thumbnail-composition-output
references:
  - "references/fim/overview/electronics-media-docfile/sharp.md"
  - "references/fim/solution/sharp.md"
prompt:
  system: |-
    You generate Sharp image-processing artifacts. Output only one complete ASCII JavaScript module. Do not use markdown fences or explanatory prose.
  text: |-
    Create a Sharp design and thumbnail composition pipeline for a high-throughput content publishing service.

    Requirements:
    - Generate a 1200x630 Open Graph image, 1080x1080 square thumbnail, and 640x360 article card from a source photo, SVG logo, title text rendered as SVG, and optional watermark.
    - Use sharp({ create }), sharp({ text }) or SVG buffers for text overlays, resize(), composite(), extend(), flatten(), tint(), modulate(), webp(), png(), jpeg(), and toBuffer().
    - Use metadata() before composition, rotate() before resize(), and clone() when multiple outputs branch from the same source.
    - Include dimensions 1200x630, 1080x1080, 640x360, logo max width 220, watermark max width 180, and deterministic safe margins.
    - Specify srgb output color profile, alpha preserved for PNG/WebP variants, alpha flattened to a fixed background for JPEG, and withMetadata({ icc: "srgb" }) where retained metadata is requested.
    - Support input formats JPEG, PNG, WebP, AVIF, SVG and output formats PNG, JPEG, WebP, AVIF, SVG overlay buffers, and JSON metadata.
    - Include memory and performance controls: resize source before compositing, reuse overlay buffers, bound title length, limitInputPixels, cache/concurrency notes, and avoid giant SVG text surfaces.
    - Emit deterministic metadata JSON with layout boxes, overlay hashes, dimensions, color choices, alpha decisions, ICC policy, encoder settings, output byte sizes, warnings, and stable filenames.
    - Include deterministic output checks for text SVG generation, layer order, color normalization, encoder settings, filenames, and metadata key order.
    - Output only the final JavaScript artifact.
  provider_options:
    max_tokens: 8192
    temperature: 0.2
output:
  text_format: javascript
  artifact_kind: sharp-design-thumbnail-composition
  dimensions:
    width: 1200
    height: 630
  color_profile: srgb-with-metadata
  alpha: png-webp-preserved-jpeg-flattened
  formats:
    - format: js
    - format: png
    - format: jpg
    - format: webp
    - format: avif
    - format: json
evaluation:
  checklist:
    - "Format validity: YAML parses as schema 0.4, generated output is one JavaScript module, and Sharp APIs are used."
    - "Semantic completeness: OG image, square thumbnail, article card, source photo, SVG/text overlays, watermark, metadata, and exports are present."
    - "Dimensions: outputs are 1200x630, 1080x1080, 640x360, logo max width is 220, watermark max width is 180, and margins are deterministic."
    - "Color profile and alpha: srgb output, metadata policy, PNG/WebP alpha preservation, and JPEG flattening are explicit."
    - "File formats: JPEG, PNG, WebP, AVIF, SVG input or buffers and PNG, JPEG, WebP, AVIF, JSON output are represented."
    - "Memory and performance: source resize before composite, overlay reuse, title bounds, pixel limits, cache/concurrency notes, and SVG surface limits are covered."
    - "Metadata: layout boxes, overlay hashes, dimensions, colors, alpha decisions, ICC policy, encoder settings, sizes, warnings, and filenames are recorded."
    - "Deterministic output: text SVG generation, layer order, color normalization, encoder settings, filenames, and metadata keys are stable."
  rubric:
    - name: "Format validity"
      weight: 30
      criteria: "The prompt YAML and generated JavaScript are parseable, ASCII-only, and use Sharp for compositing."
    - name: "Semantic completeness"
      weight: 30
      criteria: "The artifact covers designed output variants, overlays, compositing, alpha/color handling, performance constraints, metadata, and deterministic layout."
    - name: "Output quality"
      weight: 25
      criteria: "The generated social and thumbnail images are polished, legible, correctly framed, color-safe, and encoded cleanly."
    - name: "Robustness"
      weight: 15
      criteria: "The artifact handles missing overlays, long text, SVG limits, huge images, alpha flattening, codec gaps, and deterministic reruns."
  pass_conditions:
    - "YAML parses successfully and all file text is ASCII-only."
    - "Rubric weights are exactly Format validity 30, Semantic completeness 30, Output quality 25, and Robustness 15."
    - "Generated JavaScript contains no markdown fences and uses Sharp rather than node-canvas for composition."
    - "All dimensions, color profile/alpha, file format, memory/performance, metadata, and deterministic output checks are represented."
    - "Rubric score is at least 80 out of 100 and no required checklist item is absent."
tags:
  - fim
  - image-and-video-processing
  - sharp
  - design-thumbnail-composition-output
  - social-image
  - compositing
  - svg-overlay
