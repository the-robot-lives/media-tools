schema: "0.4"
id: jimp-01-canonical-transform-pipeline
type: image/visualization/data
quality: high
solution: jimp
category: image-and-video-processing
variant: canonical-transform-pipeline
references:
  - "references/fim/overview/electronics-media-docfile/jimp.md"
  - "references/fim/solution/jimp.md"
prompt:
  system: |-
    You generate Jimp image-processing artifacts. Output only one complete ASCII JavaScript module. Do not use markdown fences or explanatory prose.
  text: |-
    Create a canonical Jimp transform pipeline for a portable Node.js or browser image editor.

    Requirements:
    - Use Jimp v1 APIs: import { Jimp } from "jimp", Jimp.read(), resize({ w, h }), cover(), contain(), crop(), rotate(), flip(), color(), brightness(), contrast(), composite(), getBuffer(), getBase64(), and write().
    - Accept a file path, URL, Buffer, ArrayBuffer, or browser File converted to an ArrayBuffer.
    - Produce a square avatar PNG, a flattened JPEG preview, and metadata JSON from one source image.
    - Use deterministic dimensions: avatar 512x512, preview 1280x720, and optional crop coordinates rounded to integers.
    - Specify srgb RGBA bitmap assumptions, alpha preserved in PNG, alpha flattened to #ffffff before JPEG, and no ICC profile preservation claims.
    - Support input formats PNG, JPEG, BMP, TIFF, and GIF, and output formats PNG, JPEG, base64 data URL, and JSON.
    - Include memory and performance controls: maximum pixel count, downscale early, clone before divergent outputs, avoid unbounded scan loops, and explain Jimp's raw RGBA memory cost.
    - Emit deterministic metadata JSON with source hash, source dimensions, output dimensions, MIME types, alpha decisions, transform steps, warnings, and stable output filenames.
    - Include deterministic output checks for operation order, rounded crop boxes, filenames, metadata key order, and JPEG quality.
    - Output only the final JavaScript artifact.
  provider_options:
    max_tokens: 8192
    temperature: 0.2
output:
  text_format: javascript
  artifact_kind: jimp-canonical-transform-module
  dimensions:
    width: 1280
    height: 720
  color_profile: srgb-rgba-assumed
  alpha: png-preserved-jpeg-flattened
  formats:
    - format: js
    - format: png
    - format: jpg
    - format: json
evaluation:
  checklist:
    - "Format validity: YAML parses as schema 0.4, generated output is one JavaScript module, and Jimp v1 APIs are used."
    - "Semantic completeness: loading, resize, crop, color adjustment, composite or watermark, PNG output, JPEG output, and metadata JSON are present."
    - "Dimensions: avatar output is 512x512 and preview output is 1280x720 with deterministic crop rounding."
    - "Color profile and alpha: srgb RGBA assumptions, PNG alpha preservation, JPEG flattening, and ICC limitations are explicit."
    - "File formats: PNG, JPEG, BMP, TIFF, GIF input and PNG, JPEG, base64, JSON output are represented."
    - "Memory and performance: pixel caps, early downscale, clone use, RGBA memory cost, and bounded scan behavior are covered."
    - "Metadata: source hash, source dimensions, output dimensions, MIME types, alpha decisions, transform steps, warnings, and filenames are recorded."
    - "Deterministic output: operation order, crop rounding, filenames, metadata keys, and quality settings are stable."
  rubric:
    - name: "Format validity"
      weight: 30
      criteria: "The prompt YAML and generated JavaScript are parseable, ASCII-only, and use Jimp as the image engine."
    - name: "Semantic completeness"
      weight: 30
      criteria: "The artifact covers loading, transformation, branch outputs, format encoding, alpha handling, metadata, and deterministic naming."
    - name: "Output quality"
      weight: 25
      criteria: "The generated images are correctly sized, visually clear, alpha-safe, and encoded with suitable quality settings."
    - name: "Robustness"
      weight: 15
      criteria: "The artifact handles unsupported inputs, high memory use, mutation side effects, JPEG alpha loss, and deterministic reruns."
  pass_conditions:
    - "YAML parses successfully and all file text is ASCII-only."
    - "Rubric weights are exactly Format validity 30, Semantic completeness 30, Output quality 25, and Robustness 15."
    - "Generated JavaScript contains no markdown fences and uses Jimp rather than Sharp or Canvas."
    - "All dimensions, color profile/alpha, file format, memory/performance, metadata, and deterministic output checks are represented."
    - "Rubric score is at least 80 out of 100 and no required checklist item is absent."
tags:
  - fim
  - image-and-video-processing
  - jimp
  - canonical-transform-pipeline
  - portable-image-processing
  - png
  - jpeg
