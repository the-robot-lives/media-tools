# v0.3 back-compat fixture — pins service: explicitly; kept as-is for backward-compatibility testing
schema: "0.3"
id: mermaid-arch-001
type: diagram
service: z.ai
model: grok-4.3

prompt:
  system: |
    You are a Mermaid diagram generator.
    RULES:
    - Output ONLY valid Mermaid markup. Start with the diagram type (e.g. flowchart TD).
    - Do NOT wrap output in markdown code fences (no ```mermaid, no ```).
    - Do NOT include any explanation before or after the diagram.
    - Use only Mermaid-supported syntax — no raw HTML except <br/> in labels.
  text: |
    Create a system architecture diagram showing: load balancer → 3 app servers → shared PostgreSQL + Redis.
    Include health check endpoints and connection pooling annotations.
    Use flowchart TD layout.
  provider_options:
    max_tokens: 4096
    temperature: 0.2

output:
  formats:
    - format: mmd
    - format: svg
  diagram_type: mermaid

post_processing:
  - action: render
    params:
      tool: mermaid
      output_format: svg
      theme: dark
      background: transparent

tags: [architecture, diagram, mermaid]

eval:
  pass_threshold: 0.7
  required_pass: [prompt_coverage]
  criteria:
    prompt_coverage:
      weight: 3
      description: "Primary entities and edges from the brief are present"
    syntax_quality:
      weight: 2
      description: "Valid DSL; no markdown fences"
    readability:
      weight: 2
      description: "Labels short and legible when rendered"
    layout:
      weight: 1
      description: "Logical flow"
  reject_if:
    - "missing primary node named in brief"
