schema: "0.3"
id: plantuml-class-001
type: diagram
service: openai-chat
model: gpt-4.1

prompt:
  system: "You are a PlantUML generator. Output ONLY valid PlantUML markup starting with @startuml and ending with @enduml. No explanation."
  text: "Create a class diagram for a simple e-commerce domain: Product, Cart, CartItem, Order, OrderLine, Customer. Show relationships (composition, association) and key attributes."
  provider_options:
    max_tokens: 4096
    temperature: 0.2

output:
  formats:
    - format: puml
    - format: svg
  diagram_type: plantuml

post_processing:
  - action: render
    params:
      tool: plantuml
      output_format: svg

tags: [class-diagram, uml, ecommerce]
