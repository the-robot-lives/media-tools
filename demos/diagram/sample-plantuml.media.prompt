# v0.3 back-compat fixture — pins service: explicitly; kept as-is for backward-compatibility testing
schema: "0.3"
id: plantuml-class-001
type: diagram
service: openai-chat
model: gpt-4.1

prompt:
  system: |
    You are a PlantUML generator.
    RULES:
    - Output ONLY valid PlantUML markup. Start with @startuml, end with @enduml.
    - Do NOT wrap output in markdown code fences (no ```plantuml, no ```).
    - Do NOT include any explanation before or after the diagram.
  text: |
    Create a class diagram for a simple e-commerce domain: Product, Cart, CartItem, Order, OrderLine, Customer.
    Show relationships (composition, association) and key attributes.
  provider_options:
    max_tokens: 4096
    temperature: 0.2

output:
  formats:
    - format: puml
    - format: svg
  diagram_type: plantuml

post_processing:
  - action: render
    params:
      tool: plantuml
      output_format: svg

tags: [class-diagram, uml, ecommerce]

eval:
  pass_threshold: 0.7
  required_pass: [prompt_coverage]
  criteria:
    prompt_coverage:
      weight: 3
      description: "Primary entities and edges from the brief are present"
    syntax_quality:
      weight: 2
      description: "Valid DSL; no markdown fences"
    readability:
      weight: 2
      description: "Labels short and legible when rendered"
    layout:
      weight: 1
      description: "Logical flow"
  reject_if:
    - "missing primary node named in brief"
