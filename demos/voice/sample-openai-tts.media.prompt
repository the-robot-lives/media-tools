# v0.3 back-compat fixture — pins service: explicitly; kept as-is for backward-compatibility testing
schema: "0.3"
id: voiceover-openai-001
type: audio
service: openai-tts

prompt:
  text: "Welcome to the NoizuRPG experience. Prepare yourself for an adventure unlike anything you've seen before."
  provider_options:
    voice: nova
    instructions: "Speak with a dramatic, cinematic tone. Slow and deliberate pacing, like a movie trailer narrator."
    speed: 0.9

output:
  formats:
    - format: mp3

tags: [voiceover, intro, cinematic]
product_targets: [game-intro, trailer]

eval:
  mode: structural
  pass_threshold: 0.45
  required_pass: [technical]
  criteria:
    technical:
      weight: 3
      description: "Speech audio present, not silence, plausible duration"
    intelligibility:
      weight: 2
      description: "Structural volume proxy for intelligibility"
  reject_if:
    - "silence or near-silence"
