# v0.3 back-compat fixture — pins service: explicitly; kept as-is for backward-compatibility testing
schema: "0.3"
id: voiceover-elevenlabs-001
type: audio
service: elevenlabs

prompt:
  text: "In a world where robots and humans coexist, one developer dared to build something different."
  provider_options:
    voice_id: "21m00Tcm4TlvDq8ikWAM"
    stability: 0.75
    similarity_boost: 0.8
    style: 0.4
    speed: 0.95

output:
  formats:
    - format: mp3

tags: [voiceover, dramatic]
product_targets: [trailer, podcast-intro]

eval:
  mode: structural
  pass_threshold: 0.45
  required_pass: [technical]
  criteria:
    technical:
      weight: 3
      description: "Speech audio present, not silence, plausible duration"
    intelligibility:
      weight: 2
      description: "Structural volume proxy for intelligibility"
  reject_if:
    - "silence or near-silence"
