# v0.3 back-compat fixture — pins service: explicitly; kept as-is for backward-compatibility testing
schema: "0.3"
id: voiceover-qwen-001
type: audio
service: qwen-tts

prompt:
  text: "Today is a wonderful day to build something people love. Let's create the future together."
  provider_options:
    voice: Cherry
    language: English
    instructions: "Speak warmly and enthusiastically, like greeting a friend."

output:
  formats:
    - format: mp3

tags: [voiceover, warm, friendly]
product_targets: [app-intro, onboarding]

eval:
  mode: structural
  pass_threshold: 0.45
  required_pass: [technical]
  criteria:
    technical:
      weight: 3
      description: "Speech audio present, not silence, plausible duration"
    intelligibility:
      weight: 2
      description: "Structural volume proxy for intelligibility"
  reject_if:
    - "silence or near-silence"
