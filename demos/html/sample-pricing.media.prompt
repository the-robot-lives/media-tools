# v0.3 back-compat fixture — pins service: explicitly; kept as-is for backward-compatibility testing
schema: "0.3"
id: html-pricing-001
type: html
service: openai-chat
model: gpt-4.1

prompt:
  system: "Generate a complete, self-contained HTML page with inline CSS. No external dependencies. Modern, responsive, dark-themed design."
  text: "Create a SaaS pricing page with 3 tiers: Starter ($9/mo, 1 project), Pro ($29/mo, 10 projects), Enterprise (custom). Include feature comparison, FAQ accordion with JavaScript, and CTA buttons."
  provider_options:
    max_tokens: 8192
    temperature: 0.3

output:
  formats:
    - format: html

tags: [landing-page, pricing, html]

eval:
  pass_threshold: 0.7
  required_pass: [completeness]
  visual: false
  criteria:
    completeness:
      weight: 3
      description: "All requested sections and features present"
    responsiveness:
      weight: 2
      description: "Mobile-friendly layout signals in CSS"
    cta_clarity:
      weight: 2
      description: "Primary CTA visible"
    a11y_basics:
      weight: 1
      description: "Semantic headings; controls labeled"
  reject_if:
    - "empty body"
