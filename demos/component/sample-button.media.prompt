schema: "0.4"
id: component-button-001
type: component
quality: medium

prompt:
  system: |
    Output ONLY a TypeScript Lit web component module. Import LitElement,
    html and css from lit. Use static reactive properties, scoped styles,
    and customElements.define to register app-button. No React, markdown fences,
    or explanations. Export the AppButton class.
  text: |
    Create a simple accessible app-button component with variants primary|secondary,
    an optional disabled reactive property, a label slot, and TypeScript property types.

output:
  formats:
    - format: ts
  text_format: ts

tags: [component, lit, fixture]
eval:
  pass_threshold: 0.7
  required_pass: [completeness]
  criteria:
    completeness:
      weight: 3
      description: "AppButton export, app-button registration and variants present"
    type_safety_signals:
      weight: 2
      description: "Typed reactive properties and LitElement usage present"
