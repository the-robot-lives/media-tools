# Media Workbench — macOS UX direction mockup: Atelier
schema: "0.4"
id: mw-direction-atelier
type: image
service: gemini
model: gemini-3-pro-image
quality: high
prompt:
  text: |
    A macOS desktop application window, warm cream paper #F7F3EC background with visible laid-paper grain. Left: a column of typeset serif body text like a manuscript page with red-brown editorial revision marks in the margin. Right: three small printed image plates pinned with subtle drop shadows. Oxblood #8C3A2B accents. Letterpress feel, generous margins.
  negative: >
    garbled text, lorem ipsum, watermark, logo, photorealistic human,
    mobile phone frame, browser chrome, Windows UI, web page, tablet, iPhone
  style: "UI design mockup, straight-on screenshot framing, no perspective, no camera tilt"
output:
  formats:
    - format: png
      quality: 95
  dimensions:
    width: 2560
    height: 1600
    aspect_ratio: "16:10"
eval:
  pass_threshold: 0.7
  criteria:
    direction_legible:
      weight: 0.4
      description: "palette, density and material read clearly at a glance"
    macos_native:
      weight: 0.3
      description: "reads as a Mac desktop application window"
    distinct:
      weight: 0.3
      description: "not interchangeable with the other four directions"
tags: [design-direction, macos, media-workbench]
