<!-- HEADER -->
<section class="page-head">
  <div class="container">
    <p class="eyebrow">Provider matrix</p>
    <h1>Providers</h1>
    <p class="lede">
      media-tool ships with a provider registry spanning images, music, voice, and video —
      plus text-capable chat providers for SVG, diagrams, and HTML. Pick by quality tier and
      let the CLI walk the ladder, or pin <code>service:</code> when you need a specific
      vendor.
    </p>
  </div>
</section>

